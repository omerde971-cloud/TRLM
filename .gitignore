# =====================================================================
# TRLM — .gitignore
# Open-source code/config release. Third-party & non-OSS content excluded.
# =====================================================================

# --- Unity generated / cache folders (regenerated by Unity) ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# --- Unity generated IDE/project files (not source of truth) ---
*.csproj
*.sln
*.slnx
*.unityproj
*.suo
*.tmp
*.user
*.userprefs
.vs/
.vsconfig

# --- Autogenerated crash / asset-db files ---
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# --- Source asset archives (large, not part of the working project) ---
Assets_Source/

# --- Tooling / local session config (not game content) ---
.claude/

# --- OS junk ---
.DS_Store
Thumbs.db

# =====================================================================
# Third-party / purchased assets — NOT part of the OSS release.
# See THIRD_PARTY_NOTICES.md.
# =====================================================================
Assets/ThirdParty/
Assets/npc_casual_set_00/
Assets/npc_casual_set_00.meta
Assets/StarterAssets/
Assets/StarterAssets.meta
Assets/TutorialInfo/
Assets/TutorialInfo.meta
Assets/Readme.asset
Assets/Readme.asset.meta
Assets/Scenes/
Assets/Scenes.meta

# --- Unknown-license audio binaries (mixer config is kept, clips are not) ---
Assets/_TRLM/Audio/**/*.mp3
Assets/_TRLM/Audio/**/*.wav

# --- Non-verified UI art ---
Assets/_TRLM/UI/MainMenu/MainMenu_Background.png
Assets/_TRLM/UI/MainMenu/MainMenu_Background.png.meta

# --- Dev artifacts (captures / screenshots) ---
Captures/
Assets/Captures/
Assets/Captures.meta
Assets/Screenshots/
Assets/Screenshots.meta

# =====================================================================
# Secrets / credentials (defense in depth — never commit these)
# =====================================================================
*.env
.env*
*.key
*.pem
*.pfx
*.p12
*.keystore
secrets*
credentials*
*.token
